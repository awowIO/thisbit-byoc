# Copy to terraform.tfvars (or copy the pre-filled values from
# https://thisbit.ai/dashboard/integrations.html#key-vault-card -> Provision new resources).

resource_group_name  = "rg-thisbit-cauchy"
storage_account_name = "stthisbitcauchy01"
location             = "westeurope"

# Optional: also create an Azure Key Vault for zero-custody tracker / AI secrets:
# key_vault_name = "kv-thisbit-cauchy01"

# Optional: use an existing resource group instead of creating a new one:
# create_resource_group = false
